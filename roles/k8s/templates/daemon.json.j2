{
  "max-concurrent-downloads": 20,
  "log-driver": "json-file",
  "log-level": "warn",
  "log-opts": {
    "max-size": "10m",
    "max-file": "3"
  },
  "exec-opts": [
    "native.cgroupdriver=systemd"
  ],
  "insecure-registries": [
    "sealos.hub:5000",
    "{{ harborip }}:{{harborport}}",
    "{{docker_proxy}}"
  ],
  "registry-mirrors": ["http://{{ harborip }}:{{harborport}}","https://g6qv8ev4.mirror.aliyuncs.com","https://dockerpull.org"],
  "data-root": "{{data_dir}}/k8s/docker"
}